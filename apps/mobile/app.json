{
  "expo": {
    "name": "Kobo Tracker",
    "slug": "kobo-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kobo",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.davidadokuru.kobo",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/kobo-mark.png",
        "backgroundColor": "#0C1222",
        "monochromeImage": "./assets/images/kobo-mark.png"
      }
    },
    "plugins": [
      "expo-router",
      "./plugins/with-watermelondb",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF8",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-widgets",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
