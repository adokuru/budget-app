{
  "expo": {
    "name": "Kobo Tracker",
    "slug": "kobo-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kobo-mark.png",
    "scheme": "kobo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.davidadokuru.kobo",
      "supportsTablet": false,
      "icon": "./assets/kobo-tracker.icon",
      "appleTeamId": "25966HW4KV",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.davidadokuru.kobo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/kobo-mark-android.png",
        "backgroundColor": "#111A3A",
        "monochromeImage": "./assets/images/kobo-mark-android.png"
      }
    },
    "plugins": [
      "expo-router",
      "./plugins/with-watermelondb",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1F0EA",
          "image": "./assets/images/kobo-mark.png",
          "imageWidth": 104,
          "dark": {
            "backgroundColor": "#080B14",
            "image": "./assets/images/kobo-mark.png"
          }
        }
      ],
      "./plugins/with-widget-container-background",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.davidadokuru.kobo.widgets",
          "groupIdentifier": "group.com.davidadokuru.kobo",
          "widgets": [
            {
              "name": "BudgetProgress",
              "displayName": "Budget Progress",
              "description": "See what you have spent and what is left this month.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "contentMarginsDisabled": false,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": false
              }
            }
          ]
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.davidadokuru.kobo.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.davidadokuru.kobo"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "d9bf0288-15e0-434f-ad59-fe7f004e7714"
      }
    },
    "owner": "davidghena"
  }
}
