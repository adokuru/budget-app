{
  "expo": {
    "name": "Kobo Tracker",
    "slug": "kobo-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kobo",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.davidadokuru.kobo",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "appleTeamId": "25966HW4KV"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/kobo-mark.png",
        "backgroundColor": "#0C1222",
        "monochromeImage": "./assets/images/kobo-mark.png"
      }
    },
    "plugins": [
      "expo-router",
      "./plugins/with-watermelondb",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF8",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.davidadokuru.kobo.widgets",
          "groupIdentifier": "group.com.davidadokuru.kobo",
          "widgets": [
            {
              "name": "BudgetProgress",
              "displayName": "Budget Progress",
              "description": "See what you have spent and what is left this month.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "contentMarginsDisabled": false,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": false
              }
            }
          ]
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
